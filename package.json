{
  "name": "mce",
  "private": true,
  "version": "0.2.0",
  "license": "GPL-3.0-or-later",
  "repository": "github:MadhusudhanPathak/metadatacopierandeditor",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "fetch-engine": "node scripts/fetch-engine.mjs",
    "fixtures": "node scripts/make-fixtures.mjs",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "test:e2e": "cargo test --manifest-path src-tauri/Cargo.toml --test e2e -- --test-threads=1",
    "build:exe": "tauri build --no-bundle"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/leaflet": "1.9",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
