# Dependencies and build output (all reproducible: `npm ci`, `npm run build:exe`)
node_modules/
dist/
dist-ssr/
src-tauri/target/
src-tauri/gen/
*.tsbuildinfo

# Pinned ExifTool downloads (re-fetched and hash-checked by `npm run fetch-engine`)
engine/cache/

# Generated test media (`npm run fixtures`)
src-tauri/tests/fixtures/

# Release binaries: upload them to GitHub Releases, don't commit them.
# releases/RELEASE_NOTES.md stays tracked.
releases/*
!releases/RELEASE_NOTES.md

# Logs, environment and local files
*.log
*.local
.env
.env.*

# Editors and tools
.vscode/*
!.vscode/extensions.json
.idea/
*.iml
.vs/
.fleet/
.claude/
*.suo
*.sw?
*~

# OS
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
