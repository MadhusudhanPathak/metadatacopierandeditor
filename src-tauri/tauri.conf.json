{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Metadata Copier and Editor",
  "version": "0.1.0",
  "mainBinaryName": "MetadataCopierAndEditor",
  "identifier": "app.mce.metadatacopier",
  "build": {
    "beforeDevCommand": "npm run fetch-engine && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run fetch-engine && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Metadata Copier and Editor",
        "width": 1100,
        "height": 780,
        "minWidth": 420,
        "minHeight": 560,
        "backgroundColor": "#000000",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://tile.openstreetmap.org",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost https://nominatim.openstreetmap.org",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "copyright": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
