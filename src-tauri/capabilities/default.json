{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Only what the UI needs: events, file/folder pickers, reveal-in-folder, and opening a few known links in the user's browser.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://www.openstreetmap.org/*" },
        { "url": "https://exiftool.org/*" },
        { "url": "https://github.com/MadhusudhanPathak/metadatacopierandeditor*" },
        { "url": "https://developer.microsoft.com/*" }
      ]
    }
  ]
}
